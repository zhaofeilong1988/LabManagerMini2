/* components/training/training.wxss */

.training-page {
  height: 100%;
  background: #F5FAFD;
}

.training-scroll {
  height: 100%;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.training-bottom {
  height: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
}

/* ── 模块概览卡 ── */
.module-overview {
  background: linear-gradient(135deg, #0A7BB8 0%, #33ADDE 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.module-overview::before {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
}

.module-overview__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.module-overview__sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 6rpx;
}

.module-overview__stats {
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  background: rgba(255,255,255,0.14);
  border-radius: 16rpx;
  padding: 22rpx 0;
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border-right: 1rpx solid rgba(255,255,255,0.18);
}

.overview-item:last-child {
  border-right: none;
}

.overview-item__num {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.overview-item__label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}

/* ── Section Header ── */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

.section-header__left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-dot {
  width: 8rpx;
  height: 32rpx;
  background: #33ADDE;
  border-radius: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0E3A50;
}

.section-badge {
  background: #33ADDE;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* ── 证书横滑 ── */
.cert-scroll {
  width: 100%;
  margin-bottom: 24rpx;
}

.cert-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
  width: max-content;
}

.cert-card {
  width: 220rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
  flex-shrink: 0;
}

.cert-card__icon {
  margin-bottom: 12rpx;
}

.cert-card__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #0E3A50;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cert-card__date {
  font-size: 22rpx;
  color: #6E7F8A;
}

.cert-card__badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: #DBEFF9;
  color: #33ADDE;
}

.cert-card__badge--special {
  background: #FFF3E0;
  color: #FF8F00;
}

.empty-cert {
  text-align: center;
  color: #6E7F8A;
  font-size: 24rpx;
  padding: 24rpx 0 32rpx;
}

/* ── 筛选 Tab ── */
.filter-tabs {
  display: flex;
  gap: 0;
  background: #E1EBF2;
  border-radius: 20rpx;
  padding: 4rpx;
}

.filter-tab {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  color: #6E7F8A;
  transition: all 0.2s;
}

.filter-tab.active {
  background: #fff;
  color: #33ADDE;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* ── 培训卡片 ── */
.training-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.training-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.training-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.training-card__tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.training-card__tag--safety {
  background: #E1F2FA;
  color: #0D86BE;
}

.training-card__tag--special {
  background: #DBEFF9;
  color: #0D86BE;
}

.training-card__tag--plan {
  background: #FFF3E0;
  color: #E65100;
}

.training-card__status {
  font-size: 20rpx;
  font-weight: 500;
}

.training-card__status--open { color: #33ADDE; }
.training-card__status--enrolled { color: #0D86BE; }
.training-card__status--full { color: #FF7043; }
.training-card__status--ended { color: #6E7F8A; }

.training-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0E3A50;
  margin-bottom: 10rpx;
}

.training-card__instrument {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6E7F8A;
  margin-bottom: 16rpx;
}

.training-card__meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #6E7F8A;
}

.training-card__footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.capacity-bar {
  flex: 1;
  height: 6rpx;
  background: #E1EBF2;
  border-radius: 3rpx;
  overflow: hidden;
}

.capacity-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #33ADDE, #0A7BB8);
  border-radius: 3rpx;
}

.btn-enroll {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  border: none;
  background: #33ADDE;
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 48rpx;
}

.btn-enroll::after {
  border: none;
}

.btn-enroll--plain {
  background: #ffffff;
  color: #33ADDE;
  border: 2rpx solid #33ADDE;
}

.status-full {
  font-size: 22rpx;
  color: #FF7043;
  flex-shrink: 0;
}

.status-ended {
  font-size: 22rpx;
  color: #6E7F8A;
  flex-shrink: 0;
}
