<scroll-view class="profile-page" scroll-y="true" enhanced="true" show-scrollbar="false">

<!-- 顶部 header -->
<view class="profile-header">
  <view class="header-bg"></view>
  <view class="header-content">
    <view class="avatar-wrap">
      <van-icon name="contact" size="48px" color="#fff" />
    </view>
    <view class="user-info">
      <text class="user-name">张三</text>
      <text class="user-dept">实验研究中心</text>
      <view class="user-role-tag">院内用户</view>
    </view>
  </view>
</view>

<!-- 准入进度卡片 -->
<view class="section-card progress-card">
  <view class="card-header-row">
    <text class="card-title">平台准入进度</text>
    <text class="card-link">查看详情 ›</text>
  </view>
  <view class="progress-steps">
    <view class="step done">
      <view class="step-circle done-circle"><van-icon name="success" size="14px" color="#fff" /></view>
      <text class="step-label">申请登记</text>
    </view>
    <view class="step-line done-line"></view>
    <view class="step done">
      <view class="step-circle done-circle"><van-icon name="success" size="14px" color="#fff" /></view>
      <text class="step-label">安全考试</text>
    </view>
    <view class="step-line active-line"></view>
    <view class="step active">
      <view class="step-circle active-circle"><text class="step-num">3</text></view>
      <text class="step-label active-label">审批审核</text>
    </view>
    <view class="step-line gray-line"></view>
    <view class="step">
      <view class="step-circle gray-circle"><text class="step-num gray-num">4</text></view>
      <text class="step-label gray-label">准入完成</text>
    </view>
  </view>
  <view class="progress-status-row">
    <view class="status-left">
      <view class="orange-dot"></view>
      <text class="status-text">审批文件审核中，预计1-3个工作日</text>
    </view>
    <button class="status-btn" size="mini">查看</button>
  </view>
</view>

<!-- 准入与权限 -->
<view class="group-label">准入与权限</view>
<view class="section-card">
  <view class="menu-item" bindtap="goToAdmission">
    <view class="menu-left">
      <van-icon name="description" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">平台准入申请</text>
        <text class="menu-desc">安全考试 · 审批文件 · 权限开通</text>
      </view>
    </view>
    <view class="menu-right">
      <view class="badge-tag reviewing">审核中</view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToMyApplications">
    <view class="menu-left">
      <van-icon name="records" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">我的申请记录</text>
        <text class="menu-desc">查看历史申请及审批结果</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToPermission">
    <view class="menu-left">
      <van-icon name="label-o" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">我的权限身份</text>
        <text class="menu-desc">院内用户 · 标准计费</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
</view>

<!-- 仪器预约 -->
<view class="group-label">仪器预约</view>
<view class="section-card">
  <view class="menu-item" bindtap="goToMyBookings">
    <view class="menu-left">
      <van-icon name="orders-o" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">我的预约</text>
        <text class="menu-desc">查看当前及历史预约记录</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToUsageRecord">
    <view class="menu-left">
      <van-icon name="balance-list-o" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">使用记录与费用</text>
        <text class="menu-desc">历史使用时长及扣费明细</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
</view>

<!-- 工位与培训 -->
<view class="group-label">工位与培训</view>
<view class="section-card">
  <view class="menu-item disabled">
    <view class="menu-left">
      <van-icon name="desktop" size="22px" color="#aaa" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title disabled-title">我的工位</text>
        <text class="menu-desc">工位申请与使用状态</text>
      </view>
    </view>
    <view class="menu-right">
      <view class="badge-tag coming-soon">即将上线</view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>
  <view class="divider"></view>
  <view class="menu-item disabled">
    <view class="menu-left">
      <van-icon name="records" size="22px" color="#aaa" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title disabled-title">我的培训</text>
        <text class="menu-desc">培训报名记录与证书</text>
      </view>
    </view>
    <view class="menu-right">
      <view class="badge-tag coming-soon">即将上线</view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>
</view>

<!-- 其他 -->
<view class="group-label">其他</view>
<view class="section-card">
  <view class="menu-item" bindtap="goToSettings">
    <view class="menu-left">
      <van-icon name="setting-o" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">设置</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToHelp">
    <view class="menu-left">
      <van-icon name="question-o" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">帮助与反馈</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
</view>

<!-- 新版功能 -->
<view class="group-label">新版功能</view>
<view class="section-card">
  <view class="menu-item" bindtap="goToNewAdmission">
    <view class="menu-left">
      <van-icon name="description" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">准入申请</text>
      </view>
    </view>
    <view class="menu-right">
      <view class="badge-tag approving">审批中</view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>
</view>

<!-- 底部审批入口（演示） -->
<view class="approval-entry" bindtap="goToApprovalDemo">
  <van-icon name="description" size="18px" color="#1B5270" />
  <text class="approval-entry-text">审批入口（演示）</text>
</view>

<view class="bottom-safe-area"></view>
</scroll-view>
