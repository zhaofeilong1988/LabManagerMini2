<scroll-view class="profile-page" scroll-y="true" enhanced="true" show-scrollbar="false">

<!-- 顶部 header -->
<view class="profile-header">
  <view class="header-content">
    <view class="avatar-wrap">
      <text class="avatar-text">{{userInfo.avatarText || userInfo.name}}</text>
    </view>
    <view class="user-info">
      <view class="user-name-row">
        <text class="user-name">{{userInfo.name}}</text>
        <view class="user-role-tag">{{userInfo.role}}</view>
      </view>
      <view class="user-meta">
        <view wx:if="{{userInfo.loginName}}" class="user-meta-item">
          <text class="user-meta-label">登录名</text>
          <text class="user-meta-value">{{userInfo.loginName}}</text>
        </view>
        <view wx:if="{{userInfo.phone}}" class="user-meta-item">
          <text class="user-meta-label">手机号</text>
          <text class="user-meta-value">{{userInfo.phone}}</text>
        </view>
        <view wx:if="{{userInfo.amount}}" class="user-meta-item">
          <text class="user-meta-label user-meta-label--w4">账户余额</text>
          <text class="user-meta-value">{{amountVisible ? '¥' + userInfo.amount : '¥ ****'}}</text>
          <!-- 眨眼开关：睁眼展示余额，闭眼隐藏（默认闭眼） -->
          <view class="user-meta-eye" hover-class="user-meta-eye--hover" catch:tap="onToggleAmount">
            <van-icon name="{{amountVisible ? 'eye-o' : 'closed-eye'}}" size="30rpx" color="rgba(255,255,255,0.9)" />
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 准入进度卡片（数据来自 /system/apply_user/access，与平台准入申请页节点一致） -->
<view class="section-card progress-card">
  <view class="card-header-row">
    <text class="card-title">平台准入进度</text>
    <text class="card-link" bindtap="goToOnboarding">查看详情 ›</text>
  </view>
  <view class="progress-steps">
    <block wx:for="{{pSteps}}" wx:key="label">
      <view wx:if="{{index > 0}}" class="step-line {{item.lineCls}}"></view>
      <view class="step {{item.status}}">
        <view class="step-circle {{item.circleCls}}">
          <van-icon wx:if="{{item.showCheck}}" name="success" size="14px" color="#fff" />
          <text wx:else class="step-num {{item.numCls}}">{{item.num}}</text>
        </view>
        <text class="step-label {{item.labelCls}}">{{item.label}}</text>
      </view>
    </block>
  </view>
  <view class="progress-status-row">
    <view class="status-left">
      <view class="{{statusDone ? 'green-dot' : 'orange-dot'}}"></view>
      <text class="status-text">{{statusText}}</text>
    </view>
    <view class="status-btn" bindtap="viewProgress">查看</view>
  </view>
</view>

<!-- 准入与权限 -->
<view class="group-label">准入与权限</view>
<view class="section-card">
  <view class="menu-item" bindtap="goToOnboarding">
    <view class="menu-left">
      <van-icon name="description" size="22px" color="#1B5270" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">平台准入申请</text>
        <text class="menu-desc">安全考试 · 审批文件 · 权限开通</text>
      </view>
    </view>
    <view class="menu-right">
      <view class="badge-tag {{admissionBadge.cls}}">{{admissionBadge.text}}</view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToMyCertificates">
    <view class="menu-left">
      <van-icon name="award-o" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">我的证书</text>
        <text class="menu-desc">查看已获得的培训证书</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
</view>

<!-- 账户（参照 LabManagerMini/components/profile：充值提示联系管理员、月卡跳使用记录） -->
<view class="group-label">账户</view>
<view class="section-card">
  <view class="menu-item" bindtap="onRecharge">
    <view class="menu-left">
      <van-icon name="gold-coin-o" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">账户充值</text>
        <text class="menu-desc">请联系管理员进行充值</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToUsageRecord">
    <view class="menu-left">
      <van-icon name="coupon-o" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">月卡</text>
        <text class="menu-desc">月卡有效期与购买记录</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
</view>

<!-- 仪器预约 -->
<view class="group-label">仪器预约</view>
<view class="section-card">
  <view class="menu-item" bindtap="goToMyBookings">
    <view class="menu-left">
      <van-icon name="orders-o" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">我的预约</text>
        <text class="menu-desc">查看当前及历史预约记录</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToUsageRecord">
    <view class="menu-left">
      <van-icon name="balance-list-o" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">使用记录与费用</text>
        <text class="menu-desc">历史使用时长及扣费明细</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
</view>

<!-- 工位与培训 -->
<view class="group-label">工位与培训</view>
<view class="section-card">
  <view class="menu-item" bindtap="goToMyStation">
    <view class="menu-left">
      <van-icon name="desktop" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">我的工位</text>
        <text class="menu-desc">工位申请与使用状态</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item disabled">
    <view class="menu-left">
      <van-icon name="records" size="22px" color="#aaa" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title disabled-title">我的培训</text>
        <text class="menu-desc">培训报名记录与证书</text>
      </view>
    </view>
    <view class="menu-right">
      <view class="badge-tag coming-soon">即将上线</view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>
</view>

<!-- 其他 -->
<view class="group-label">其他</view>
<view class="section-card">
  <view class="menu-item" bindtap="openPwdModal">
    <view class="menu-left">
      <van-icon name="lock" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">修改密码</text>
        <text class="menu-desc">设置后台管理系统登录密码</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToSettings">
    <view class="menu-left">
      <van-icon name="setting-o" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">设置</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
  <view class="divider"></view>
  <view class="menu-item" bindtap="goToHelp">
    <view class="menu-left">
      <van-icon name="question-o" size="22px" color="#0A7BB8" class="menu-icon" />
      <view class="menu-text">
        <text class="menu-title">帮助与反馈</text>
      </view>
    </view>
    <van-icon name="arrow" size="14px" color="#ccc" />
  </view>
</view>

<!-- 重新登录 -->
<view class="relogin-entry" bindtap="relogin">
  <text class="relogin-text">退出并重新登录</text>
</view>

<view class="bottom-safe-area"></view>
</scroll-view>

<!-- 修改密码弹窗 -->
<view class="pwd-mask" wx:if="{{showPwdModal}}" bindtap="closePwdModal" catchtouchmove="noop"></view>
<view class="pwd-dialog" wx:if="{{showPwdModal}}">
  <view class="pwd-icon"><van-icon name="lock" size="30px" color="#0A7BB8" /></view>
  <view class="pwd-title">修改密码</view>
  <view class="pwd-sub">设置密码后即可登录后台管理系统（web 端），密码需为 6-20 位字符</view>
  <!-- 登录账号：web 端登录用的登录名（user.loginName），取不到时整行不展示 -->
  <view class="pwd-account" wx:if="{{userInfo.loginName}}">
    <text class="pwd-account-label">登录名</text>
    <text class="pwd-account-value">{{userInfo.loginName}}</text>
  </view>
  <view class="pwd-field">
    <text class="pwd-label">新密码</text>
    <input class="pwd-input" password="{{true}}" placeholder="请输入 web 端登录密码（6-20位）" placeholder-class="pwd-ph" value="{{newPwd}}" bindinput="onNewPwdInput" />
  </view>
  <view class="pwd-actions">
    <view class="pwd-btn pwd-btn--cancel" bindtap="closePwdModal">取消</view>
    <view class="pwd-btn pwd-btn--primary" bindtap="submitPwd">确认修改</view>
  </view>
</view>
