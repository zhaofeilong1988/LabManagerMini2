/* profile.wxss */

.profile-page {
  background: #F5FAFD;
  height: 100%;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

/* ---- Header ---- */
.profile-header {
  background: linear-gradient(135deg, #1B5270 0%, #03A9F4 100%);
  padding: 60rpx 32rpx 40rpx;
}
.header-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
}
.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1;
}
.user-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.user-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.user-role-tag {
  display: inline-flex;
  align-items: center;
  height: 32rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.22);
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
  flex-shrink: 0;
}
.user-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 4rpx;
}
.user-meta-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
  line-height: 1.3;
}
.user-meta-label {
  flex: 0 0 96rpx;
  width: 96rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
}
/* 四字标签（账户余额）：默认 96rpx 放不下四个字 */
.user-meta-label--w4 {
  flex: 0 0 120rpx;
  width: 120rpx;
}
.user-meta-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #fff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 余额可见性切换（默认闭眼） */
.user-meta-eye {
  flex-shrink: 0;
  margin-left: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-meta-eye--hover {
  opacity: 0.7;
}

/* ---- Cards ---- */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 24rpx 0rpx;
  padding: 0;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* ---- Progress Card ---- */
.progress-card {
  margin-top: -20rpx;
  padding: 28rpx 28rpx 20rpx;
}
.card-header-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.card-link {
  font-size: 24rpx;
  color: #33ADDE;
}
.progress-steps {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
}
.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.done-circle {
  background: #33ADDE;
}
.active-circle {
  background: #fff;
  border: 3rpx solid #FF9800;
  color: #FF9800;
}
.gray-circle {
  background: #fff;
  border: 3rpx solid #ccc;
}
.step-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF9800;
}
.gray-num {
  color: #bbb;
}
.step-label {
  font-size: 20rpx;
  color: #33ADDE;
}
.active-label {
  color: #FF9800;
  font-weight: 600;
}
.gray-label {
  color: #bbb;
}
.step-line {
  flex: 1;
  height: 3rpx;
  margin-bottom: 20rpx;
}
.done-line { background: #33ADDE; }
.active-line { background: #FF9800; }
.gray-line { background: #ddd; }

.progress-status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #FFF8E1;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}
.status-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}
.orange-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF9800;
  flex-shrink: 0;
}
.green-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4CAF50;
  flex-shrink: 0;
}
.status-text {
  font-size: 22rpx;
  color: #555;
}
.status-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 52rpx;
  padding: 0 28rpx;
  margin: 0;
  border: none;
  border-radius: 26rpx;
  background: #33ADDE;
  box-shadow: 0 2rpx 8rpx rgba(51, 173, 222, 0.35);
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ---- Group Label ---- */
.group-label {
  font-size: 24rpx;
  color: #999;
  padding: 28rpx 32rpx 12rpx;
  font-weight: 500;
}

/* ---- Menu Items ---- */
.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}
.menu-item.disabled {
  opacity: 0.6;
}
.menu-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}
.menu-icon {
  flex-shrink: 0;
}
.menu-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.menu-title {
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
}
.menu-title.disabled-title {
  color: #888;
}
.menu-desc {
  font-size: 22rpx;
  color: #999;
}
.menu-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}
.divider {
  height: 1rpx;
  background: #f2f2f2;
  margin: 0 28rpx;
}

/* ---- Badge Tags ---- */
.badge-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.badge-tag.reviewing {
  background: #FFF3E0;
  color: #FF9800;
}
.badge-tag.coming-soon {
  background: #FFF3E0;
  color: #FF9800;
}
.badge-tag.approving {
  background: #FFF3E0;
  color: #FF9800;
}
.badge-tag.passed {
  background: #E8F5E9;
  color: #4CAF50;
}

/* ---- Relogin Entry ---- */
.relogin-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.relogin-text {
  font-size: 28rpx;
  color: #BA1A1A;
  font-weight: 500;
}

.bottom-safe-area {
  height: 40rpx;
}

/* ---- 修改密码弹窗 ---- */
.pwd-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}
.pwd-dialog {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 56rpx;
  padding: 48rpx 40rpx 40rpx;
  z-index: 1001;
  box-shadow: 0 32rpx 80rpx rgba(14, 28, 38, 0.22);
}
.pwd-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #C9E9FA;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pwd-title {
  margin-top: 28rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #161C20;
}
.pwd-sub {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.6;
  color: #3D5263;
}
/* 弹窗中的登录账号：浅底卡片，明确「改的是哪个账号的密码」 */
.pwd-account {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E0EAF0;
  border-radius: 20rpx;
  background: #F2F7FA;
}
.pwd-account-label {
  font-size: 24rpx;
  color: #3D5263;
}
.pwd-account-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #0A7BB8;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pwd-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
}
.pwd-label {
  font-size: 24rpx;
  color: #3D5263;
  font-weight: 500;
  padding-left: 4rpx;
}
.pwd-input {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E0EAF0;
  border-radius: 24rpx;
  background: #F0F4F8;
  color: #161C20;
  font-size: 28rpx;
}
.pwd-ph {
  color: #8A9BB0;
}
.pwd-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 44rpx;
}
.pwd-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}
.pwd-btn--cancel {
  background: #EEF4F8;
  color: #3D5263;
  font-weight: 500;
}
.pwd-btn--primary {
  background: linear-gradient(135deg, #0A7BB8 0%, #33ADDE 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(10, 123, 184, 0.32);
}
.pwd-btn--primary:active {
  opacity: 0.88;
}
