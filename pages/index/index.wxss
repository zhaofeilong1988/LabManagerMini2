/* index.wxss */

/* ── MD3 天蓝色色彩 Token ── */
page {
  --md-primary:           #1B5270;
  --md-primary-light:     #03A9F4;
  --md-on-primary:        #FFFFFF;
  --md-primary-container: #C3E7FF;
  --md-on-primary-container: #001E2E;

  --md-secondary:         #4A6070;
  --md-secondary-container: #CCE5F5;
  --md-tertiary:          #574B6E;
  --md-tertiary-container: #DCDAF5;

  --md-error:             #BA1A1A;
  --md-error-container:   #FFDAD6;

  --md-background:        #F5F9FC;
  --md-surface:           #FFFFFF;
  --md-surface-variant:   #DCE4EA;
  --md-outline:           #6E8090;
  --md-outline-variant:   #C0CDD6;

  --md-on-surface:        #0E1C26;
  --md-on-surface-variant:#3D5263;

  background-color: var(--md-background);
  font-family: -apple-system, 'PingFang SC', sans-serif;
}

/* ── 全局布局 ── */
.box {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.page-view {
  flex: 1;
  overflow: hidden;
  position: relative;
  /* 高度需要明确，供内部 scroll-view 撑满 */
  height: 0;
}

/* ── Toolbar ── */
.toolbar {
  display: flex;
  flex-direction: row;
  background-color: var(--md-surface);
  border-top: 1rpx solid var(--md-outline-variant);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.toolbar-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 8rpx;
  position: relative;
  transition: all 0.2s;
}

.toolbar-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--md-primary-light);
  transition: width 0.25s ease;
}

.toolbar-button.active .toolbar-indicator {
  width: 48rpx;
}

.toolbar-label {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: var(--md-on-surface-variant);
  transition: color 0.2s;
}

.toolbar-button.active .toolbar-label {
  color: var(--md-primary-light);
  font-weight: 600;
}
