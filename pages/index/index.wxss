/* index.wxss */

/* ── MD3 天蓝色色彩 Token（源色 #33ADDE） ── */
page {
  --md-primary:           #0A7BB8;
  --md-primary-light:     #33ADDE;
  --md-on-primary:        #FFFFFF;
  --md-primary-container: #C9E9FA;
  --md-on-primary-container: #06324A;

  --md-secondary:         #4C6673;
  --md-secondary-container: #D4E6F0;
  --md-tertiary:          #5C5A9E;
  --md-tertiary-container: #E0DFF8;

  --md-error:             #BA1A1A;
  --md-error-container:   #FFDAD6;

  --md-background:        #F5FAFD;
  --md-surface:           #FFFFFF;
  --md-surface-variant:   #DCE5EA;
  --md-outline:           #71797E;
  --md-outline-variant:   #C2CAD0;

  --md-on-surface:        #161C20;
  --md-on-surface-variant:#41484D;

  --grad-primary:         linear-gradient(135deg, #0A7BB8 0%, #33ADDE 100%);
  --grad-primary-rev:     linear-gradient(135deg, #33ADDE 0%, #0A7BB8 100%);

  background-color: var(--md-background);
  font-family: -apple-system, 'PingFang SC', sans-serif;
}

/* ── 全局布局 ── */
.box {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.page-view {
  flex: 1;
  overflow: hidden;
  position: relative;
  /* 高度需要明确，供内部 scroll-view 撑满 */
  height: 0;
}

/* ── Toolbar ── */
.toolbar {
  display: flex;
  flex-direction: row;
  background-color: var(--md-surface);
  border-top: 1rpx solid var(--md-outline-variant);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.toolbar-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 8rpx;
  position: relative;
  transition: all 0.2s;
}

.toolbar-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--md-primary-light);
  transition: width 0.25s ease;
}

.toolbar-button.active .toolbar-indicator {
  width: 48rpx;
}

.toolbar-label {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: var(--md-on-surface-variant);
  transition: color 0.2s;
}

.toolbar-button.active .toolbar-label {
  color: var(--md-primary-light);
  font-weight: 600;
}
