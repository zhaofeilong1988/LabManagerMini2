/* pages/instrument-book/index.wxss */
page {
  background: #F5FAFD;
}

.bk-page {
  padding: 24rpx 0 220rpx;
}

/* ── 仪器信息条 ── */
.bk-ins {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.bk-ins-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #DBEFF9, #C9E9FA);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.bk-ins-b {
  flex: 1;
  min-width: 0;
}

.bk-ins-r {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}

.bk-ins-n {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #161C20;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bk-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.bk-tag.on {
  background: #DBEFF9;
  color: #0D86BE;
}

.bk-tag.idle {
  background: #E1F2FA;
  color: #0D86BE;
}

.bk-ins-m {
  display: block;
  font-size: 22rpx;
  color: #6E7F8A;
  margin-top: 8rpx;
}

/* ── 通用卡片 ── */
.bk-card {
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.bk-card-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.bk-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #33ADDE, #0A7BB8);
  margin-right: 12rpx;
}

.bk-card-tt {
  font-size: 30rpx;
  font-weight: 700;
  color: #161C20;
}

.bk-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #6E7F8A;
}

.bk-clear {
  margin-left: auto;
  font-size: 22rpx;
  color: #33ADDE;
  padding: 4rpx 0 4rpx 20rpx;
}

/* ── 日历 ── */
.cal-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cal-arrow {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F5FAFD;
  color: #566B78;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
}

.cal-arrow.dis {
  opacity: 0.35;
  pointer-events: none;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0E3A50;
}

.cal-week {
  display: flex;
  flex-direction: row;
  margin-bottom: 8rpx;
}

.cal-week text {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #6E7F8A;
}

.cal-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cal-cell {
  flex: 0 0 14.2857%;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #161C20;
  position: relative;
  border-radius: 42rpx;
}

.cal-cell.td {
  color: #33ADDE;
  font-weight: 700;
}

.cal-cell.td::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #33ADDE;
}

.cal-cell.dis {
  color: #C4D0D8;
}

/* 整天禁用（/api/deviceApply.disableList 覆盖全天）：淡红提示，且不可选 */
.cal-cell.ban {
  color: #D9534F;
  background: #FDF2F1;
}

.cal-cell.sel {
  background: linear-gradient(135deg, #33ADDE, #0A7BB8);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(27, 82, 112, 0.25);
}

.cal-cell.td.sel::after {
  background: #ffffff;
}

/* ── 时段 ── */
.bk-step {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  background: #DFF1F9;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
}

.bk-step.done {
  background: #E1F2FA;
}

.bk-step-n {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #33ADDE, #0A7BB8);
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 700;
}

.bk-step.done .bk-step-n {
  background: #0D86BE;
}

.bk-step-t {
  font-size: 22rpx;
  color: #0A7BB8;
  flex: 1;
}

.bk-step.done .bk-step-t {
  color: #0D86BE;
}

.bk-legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx 28rpx;
  padding: 18rpx 4rpx 22rpx;
}

.bk-lg {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #6E7F8A;
}

.lg-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
}

.lg-dot.sel {
  background: #FFC107;
  border: 2rpx solid #F57F17;
}

.lg-dot.occ {
  background: #0D86BE;
  border: 2rpx solid #0D86BE;
}

.lg-dot.idle {
  background: #FFFFFF;
  border: 2rpx solid #BDBDBD;
}

.lg-dot.off {
  background: #E0E0E0;
  border: 2rpx solid #BDBDBD;
}

/* ── 24h × 15min 连续档位表（0~23 时，每列横向 4 格） ── */
.time-table {
  margin-top: 4rpx;
  border: 1rpx solid #D9D9D9;
}

.time-group {
  border-bottom: 1rpx solid #D9D9D9;
}

.time-group:last-child {
  border-bottom: none;
}

.group-header {
  display: flex;
  flex-direction: row;
  background: #E8E8E8;
  border-bottom: 1rpx solid #D9D9D9;
}

.header-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  padding: 10rpx 0;
  border-right: 1rpx solid #D9D9D9;
}

.header-cell:last-child {
  border-right: none;
}

.group-body {
  display: flex;
  flex-direction: row;
}

.hour-col {
  flex: 1;
  display: flex;
  flex-direction: row;
  border-right: 1rpx solid #D9D9D9;
}

.hour-col:last-child {
  border-right: none;
}

.tcell {
  flex: 1;
  height: 52rpx;
}

.tcell.idle {
  background: #FFFFFF;
}

.tcell.occ {
  background: #0D86BE;
}

.tcell.off {
  background: #E0E0E0;
}

.tcell.sel {
  background: #FFC107;
}

.slot-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #0E3A50;
  margin: 4rpx 0 12rpx;
}

.bk-note {
  font-size: 20rpx;
  color: #A8B6BF;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* ── 已选时间 ── */
.sel-section {
  margin-top: 8rpx;
  background: linear-gradient(180deg, #ECF5FB, #E8F3FA);
  border: 1rpx solid #E2EAF0;
  border-radius: 20rpx;
  padding: 22rpx 24rpx 18rpx;
}

.sel-tip {
  font-size: 22rpx;
  color: #566B78;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

.sel-seg {
  background: #FFFFFF;
  border: 1rpx solid #E0EBF3;
  border-radius: 16rpx;
  padding: 4rpx 18rpx;
}

.seg-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
}

.seg-row + .seg-row {
  border-top: 1rpx dashed #EEF4F8;
}

.seg-lab {
  width: 76rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #161C20;
  line-height: 1.4;
}

.seg-chip {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 26rpx;
  color: #0A7BB8;
  border: 1rpx solid #D4E6F0;
  border-radius: 12rpx;
  padding: 12rpx 8rpx;
  background: #E8F3FA;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seg-chip.tm {
  color: #0A7BB8;
  border-color: #D5E4ED;
  background: #FFFFFF;
  letter-spacing: 1rpx;
}

.seg-chip.dis {
  color: #A8B6BF;
  border-color: #E1EBF2;
  background: #EEF4F8;
  font-weight: 400;
}

.sel-divider {
  height: 1rpx;
  background: #E2EAF0;
  margin: 14rpx 0 12rpx;
}

/* 共计汇总行 */
.sel-total {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 1rpx solid #F3D9B0;
  border-radius: 14rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(180, 130, 40, 0.08);
}

.sel-total .tl {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #A07932;
}

.sel-total .tl::before {
  content: '';
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #FFB300, #F57F17);
  margin-right: 12rpx;
}

.sel-total .tv {
  font-size: 38rpx;
  font-weight: 800;
  color: #E65100;
  letter-spacing: 1rpx;
  line-height: 1.3;
  text-align: right;
}

.bk-warn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #E65100;
  margin-top: 16rpx;
}

.bk-warn.ok {
  color: #0D86BE;
}

/* ── 时长说明（至少 / 推荐 / 最大） ── */
.dur-grid {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #E2EAF0;
}

.dur-cell {
  flex: 1;
  background: #EFF6FB;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.dur-cell.rec {
  background: #FFF8E1;
  border: 2rpx solid #FFE082;
}

.dur-cell .n {
  font-size: 40rpx;
  font-weight: 800;
  color: #0A7BB8;
}

.dur-cell.rec .n {
  color: #E65100;
}

/* 接口字段为空时显示「不限」：与具体数值同字号（40rpx）以保持 .nrow baseline 对齐；
   视觉差异仅通过「颜色 + 字重 + 字距」体现，避免 line-box 高度不一致导致三宫格错位 */
.dur-cell .n.n-unlimit {
  font-size: 40rpx;
  font-weight: 700;
  color: #6E7F8A;
  letter-spacing: 2rpx;
  line-height: 1;
}

.dur-cell.rec .n.n-unlimit {
  color: #A07932;
}

.dur-cell .u {
  font-size: 20rpx;
  color: #6E7F8A;
  margin-left: 4rpx;
}

.dur-cell .l {
  display: block;
  font-size: 20rpx;
  color: #6E7F8A;
  margin-top: 4rpx;
}

.dur-cell .nrow {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: center;
}

/* ── 计费方式 ── */
.mode-opt {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid #D5E4ED;
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.mode-opt.on {
  border-color: #33ADDE;
  background: #DFF1F9;
}

.mode-ic {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #C2CAD0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  flex-shrink: 0;
  background: #ffffff;
}

.mode-opt.on .mode-ic {
  background: #33ADDE;
  border-color: #33ADDE;
}

.mode-b {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.mode-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #0E3A50;
}

.mode-s {
  font-size: 20rpx;
  color: #6E7F8A;
}

.mode-p {
  font-size: 32rpx;
  font-weight: 800;
  color: #33ADDE;
  white-space: nowrap;
}

.mode-p .p-u {
  font-size: 20rpx;
  color: #6E7F8A;
  font-weight: 500;
}

/* ── 测试信息（选填） ── */
.bk-field + .bk-field {
  margin-top: 28rpx;
}

.bk-field-l {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #0E3A50;
  margin-bottom: 12rpx;
}

.bk-input {
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  background: #F5FAFD;
  border: 2rpx solid #D5E4ED;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #0E3A50;
}

.bk-textarea {
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
  background: #F5FAFD;
  border: 2rpx solid #D5E4ED;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #0E3A50;
  line-height: 1.5;
}

.bk-ph {
  color: #A8B6BF;
}

/* ── 底部栏 ── */
.bk-spacer {
  height: 24rpx;
}

.bk-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bk-cost {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bk-cost-l {
  font-size: 20rpx;
  color: #6E7F8A;
}

.bk-cost-v {
  font-size: 40rpx;
  font-weight: 800;
  color: #0A7BB8;
  line-height: 1.2;
}

.bk-cost-s {
  font-size: 20rpx;
  color: #6E7F8A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bk-sub {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 48rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #33ADDE, #0A7BB8);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(27, 82, 112, 0.28);
}

.bk-sub:active {
  opacity: 0.88;
}
