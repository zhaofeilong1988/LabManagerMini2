/* pages/onboarding/exam/exam.wxss */
@import "../onboarding.wxss";

/* 考试页：固定布局，导航置底 */
.exam-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.question-card {
  flex: 1;
  overflow-y: auto;
  margin: 24rpx;
  margin-bottom: 12rpx;
}

.exam-nav {
  flex-shrink: 0;
}

/* 题型标签 */
.qtype-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #F3E8FF;
  color: #7C3AED;
}

.qscore {
  font-size: 22rpx;
  color: var(--ob-hint);
}

/* 远程题目加载中 */
.exam-loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ob-hint);
}

/* 多选题提示条 */
.multi-tip {
  font-size: 24rpx;
  color: #7C3AED;
  background: #F3E8FF;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

/* 多选题选项标记改为方形，与单选区分 */
.option-item.multi .option-circle {
  border-radius: 8rpx;
}

/* 简答题输入框 */
.short-answer {
  width: 100%;
  min-height: 240rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 2rpx solid var(--ob-border);
  border-radius: 12rpx;
  background: var(--ob-bg);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ob-text);
}
