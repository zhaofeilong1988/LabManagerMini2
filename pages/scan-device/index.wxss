/* pages/scan-device/index.wxss */
.sd-page {
  --sd-primary: #0A7BB8;
  --sd-accent: #33ADDE;
  --sd-bg: #F5FAFD;
  --sd-text: #161C20;
  --sd-sub: #41484D;
  --sd-hint: #6E7F8A;
  min-height: 100vh;
  background: var(--sd-bg);
  box-sizing: border-box;
}

.sd-content {
  padding: 24rpx 24rpx 200rpx;
}

/* ── 加载 ── */
.sd-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 260rpx;
}

.sd-loading-spin {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid #D4E6F0;
  border-top-color: var(--sd-accent);
  animation: sd-spin 0.8s linear infinite;
}

@keyframes sd-spin {
  to { transform: rotate(360deg); }
}

.sd-loading-t {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--sd-hint);
}

/* ── 设备头部 ── */
.sd-hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.sd-ic {
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #DBEFF9, #C9E9FA);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.sd-hero-b {
  flex: 1;
  min-width: 0;
}

.sd-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--sd-text);
  line-height: 1.35;
}

.sd-lab {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--sd-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 开机状态条 ── */
.sd-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
}

.sd-status-l {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.sd-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.sd-status-t {
  font-size: 28rpx;
  font-weight: 700;
}

.sd-status--on {
  background: #E1F2FA;
}

.sd-status--on .sd-dot {
  background: #0D86BE;
  box-shadow: 0 0 0 6rpx rgba(13, 134, 190, 0.15);
}

.sd-status--on .sd-status-t {
  color: #0A7BB8;
}

.sd-status--off {
  background: #FFF4E5;
}

.sd-status--off .sd-dot {
  background: #E65100;
  box-shadow: 0 0 0 6rpx rgba(230, 81, 0, 0.12);
}

.sd-status--off .sd-status-t {
  color: #BF5000;
}

.sd-status-time,
.sd-status-tip {
  font-size: 22rpx;
  color: var(--sd-hint);
}

/* ── 设备信息列表 ── */
.sd-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.sd-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #E1EBF2;
}

.sd-row:last-child {
  border-bottom: none;
}

.sd-row .k {
  color: var(--sd-hint);
  flex-shrink: 0;
  line-height: 1.5;
}

.sd-row .v {
  flex: 1;
  min-width: 0;
  color: var(--sd-text);
  font-weight: 600;
  text-align: right;
  line-height: 1.5;
  word-break: break-all;
}

.sd-no {
  color: var(--sd-primary);
  font-family: Menlo, Consolas, monospace;
}

.sd-v-ok { color: #0D86BE; }
.sd-v-off { color: #BF5000; }

.sd-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--sd-hint);
  text-align: center;
}

/* ── 底部开机按钮 ── */
.sd-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.sd-btn {
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #33ADDE, #0A7BB8);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(10, 123, 184, 0.28);
}

.sd-btn--hover {
  transform: scale(0.98);
  box-shadow: 0 3rpx 8rpx rgba(10, 123, 184, 0.2);
}

.sd-btn--disabled {
  opacity: 0.7;
}

/* ── 未找到 ── */
.sd-miss {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 220rpx 60rpx 0;
}

.sd-miss-ic {
  font-size: 90rpx;
}

.sd-miss-t {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--sd-hint);
}

.sd-miss-btn {
  margin-top: 48rpx;
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0A7BB8, #33ADDE);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
