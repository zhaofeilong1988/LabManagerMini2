<!-- pages/approval-detail/index.wxml
     预约审批详情（对照参考图）：
       申请信息卡 → 罚金 / 折扣输入 → 实际价格 → 备注 → 通过 / 拒绝 / 关闭 -->
<view class="ad-page">

  <!-- 申请信息 -->
  <view class="ad-card">
    <view class="ad-dev">
      <text class="ad-dev-n">{{instName}}</text>
      <text class="ad-dev-m" wx:if="{{model}}">（{{model}}）</text>
    </view>

    <view class="ad-lines">
      <view class="ad-line">
        <text class="ad-v">{{organText || '--'}}</text>
      </view>

      <view class="ad-line">
        <text class="ad-k">预约人：</text>
        <text class="ad-v">{{user || '--'}}</text>
        <view class="ad-phone" wx:if="{{adminPhone}}">
          <van-icon name="phone-o" size="15px" color="#2E86D8" />
          <text class="ad-phone-n">{{adminPhone}}</text>
        </view>
      </view>

      <!-- 联系方式：单独一行放在预约人下面，点击直接拨号 -->
      <view class="ad-line" wx:if="{{phone}}">
        <text class="ad-k">联系方式：</text>
        <view
          class="ad-phone"
          hover-class="ad-phone--hover"
          hover-stay-time="80"
          bindtap="onCallPhone"
          data-phone="{{phone}}"
        >
          <van-icon name="phone-o" size="15px" color="#2E86D8" />
          <text class="ad-phone-n">{{phone}}</text>
        </view>
      </view>

      <view class="ad-line">
        <text class="ad-k">操作方式：</text>
        <text class="ad-v">{{modeText}}</text>
      </view>

      <view class="ad-line">
        <text class="ad-k">测试目的：</text>
        <text class="ad-v">{{memo1 || '--'}}</text>
      </view>

      <view class="ad-line">
        <text class="ad-k">测试内容及数量：</text>
        <text class="ad-v">{{memo2 || '--'}}</text>
      </view>

      <view class="ad-line">
        <text class="ad-k">备注：</text>
        <text class="ad-v">{{memo3 || '--'}}</text>
      </view>

      <view class="ad-line">
        <text class="ad-k">收费标准：</text>
        <text class="ad-v">{{priceType}}</text>
      </view>

      <view class="ad-line">
        <text class="ad-k">预估价格：</text>
        <text class="ad-v">{{unit}} × {{qty}} = <text class="ad-red">{{base}}元</text></text>
      </view>

      <view class="ad-line">
        <text class="ad-k">开始时间：</text>
        <text class="ad-v">{{begin || '--'}}</text>
      </view>

      <view class="ad-line">
        <text class="ad-k">结束时间：</text>
        <text class="ad-v">{{finish || '--'}}<text class="ad-green" wx:if="{{durText}}"> （{{durText}}）</text></text>
      </view>
    </view>
  </view>

  <!-- 罚金 -->
  <view class="ad-field">
    <text class="ad-field-k">罚金：</text>
    <input class="ad-input" type="digit" value="{{penalty}}" bindinput="onPenalty" />
  </view>

  <!-- 折扣 -->
  <view class="ad-field">
    <text class="ad-field-k">折扣：</text>
    <input class="ad-input" type="digit" value="{{discount}}" bindinput="onDiscount" />
  </view>

  <!-- 实际价格 -->
  <view class="ad-total">
    <text class="ad-total-t">实际价格： {{base}} + {{penalty}}(罚金) − {{discount}}(折扣) = <text class="ad-red">{{total}}元</text></text>
  </view>

  <!-- 备注 -->
  <view class="ad-remark">
    <textarea
      class="ad-textarea"
      placeholder="备注"
      placeholder-class="ad-ph"
      value="{{remark}}"
      bindinput="onRemark"
      maxlength="200"
    />
  </view>

  <view class="ad-spacer"></view>

  <!-- 底部操作 -->
  <view class="ad-bar">
    <view class="ad-btn ad-btn--pass" hover-class="ad-btn--hover" bindtap="onPass">通过</view>
    <view class="ad-btn ad-btn--reject" hover-class="ad-btn--hover" bindtap="onReject">拒绝</view>
    <view class="ad-btn ad-btn--close" hover-class="ad-btn--hover" bindtap="onClose">关闭</view>
  </view>

</view>
