/* pages/my-station/index.wxss —— 我的工位列表页 */

.st-wrap {
  min-height: 100vh;
  background: #F5FAFD;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ── 顶部操作条 ── */
.st-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #DBEFF9;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}

.st-bar-text {
  flex: 1;
  font-size: 24rpx;
  color: #0A7BB8;
  line-height: 1.5;
}

.st-bar-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #0A7BB8, #33ADDE);
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
}

/* ── 记录卡片 ── */
.st-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.st-card-hd {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.st-card-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  margin-right: 16rpx;
}

.st-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #161C20;
}

.st-card-sub {
  font-size: 22rpx;
  color: #6E7F8A;
}

/* 状态徽标 */
.st-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.st-badge.reviewing {
  color: #B26A00;
  background: #FFF3D6;
}

.st-badge.passed {
  color: #0D86BE;
  background: #DBEFF9;
}

.st-badge.rejected {
  color: #BA1A1A;
  background: #FDECEA;
}

/* 信息行 */
.st-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 0;
}

.st-row-key {
  font-size: 24rpx;
  color: #6E7F8A;
  width: 140rpx;
  flex-shrink: 0;
}

.st-row-val {
  font-size: 26rpx;
  color: #161C20;
  font-weight: 600;
}

/* 底部操作区（扫码打卡按钮，靠右） */
.st-card-ft {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}

/* ── 扫码打卡按钮（仅审核通过的工位显示） ── */
.st-checkin-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #0A7BB8, #33ADDE);
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
}

.st-checkin-text {
  font-size: 22rpx;
  color: #ffffff;
}

/* ── 空状态 ── */
.st-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  gap: 16rpx;
}

.st-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #161C20;
  margin-top: 16rpx;
}

.st-empty-sub {
  font-size: 24rpx;
  color: #6E7F8A;
  text-align: center;
  line-height: 1.7;
}

.st-empty-btn {
  margin-top: 32rpx;
  width: 320rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #0A7BB8, #33ADDE);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 76rpx;
  padding: 0;
  border: none;
}

.st-empty-btn::after {
  border: none;
}
