/* pages/cert-detail/index.wxss */

.cd-page {
  --cd-primary: #0A7BB8;
  --cd-accent: #33ADDE;
  --cd-bg: #F4F8FB;
  --cd-surface: #FFFFFF;
  --cd-border: #D5E4ED;
  --cd-text: #161C20;
  --cd-sub: #41484D;
  --cd-hint: #6E7F8A;
  --cd-gold: #D4A748;
  --cd-gold-light: #FCE8B2;
  --cd-ok: #0D86BE;
  --cd-success: #1E7E34;
  --cd-warn: #E65100;
  --cd-err: #BA1A1A;
  --cd-grad: linear-gradient(135deg, #0A7BB8 0%, #33ADDE 100%);
  min-height: 100vh;
  background: var(--cd-bg);
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

/* ───────── Hero ───────── */
.cd-hero {
  position: relative;
  padding: 56rpx 32rpx 96rpx;
  color: #ffffff;
  overflow: hidden;
  isolation: isolate;
}
.cd-hero-bg {
  position: absolute;
  inset: -32rpx 0 0 0;
  height: 540rpx;
  background:
    radial-gradient(circle at top right, #33ADDE 0%, transparent 60%),
    linear-gradient(160deg, #073A5C 0%, #0A7BB8 45%, #1FA0D3 100%);
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  z-index: 0;
}
/* 三块「光斑」做柔光 */
.cd-hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(20rpx);
  z-index: 0;
  opacity: 0.55;
}
.cd-hero-glow--a {
  width: 280rpx; height: 280rpx;
  top: -80rpx; right: -60rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55), transparent 70%);
}
.cd-hero-glow--b {
  width: 220rpx; height: 220rpx;
  top: 220rpx; left: -80rpx;
  background: radial-gradient(circle, rgba(108, 198, 235, 0.7), transparent 70%);
}
.cd-hero-glow--c {
  width: 160rpx; height: 160rpx;
  bottom: 80rpx; right: 30%;
  background: radial-gradient(circle, rgba(255, 210, 122, 0.45), transparent 70%);
}

/* 状态徽章 */
.cd-hero-status {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20rpx);
  z-index: 2;
}
.cd-hero-status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.25);
}
.cd-hero-status--valid .cd-hero-status-dot {
  background: #6FE18C;
  box-shadow: 0 0 0 4rpx rgba(111, 225, 140, 0.35);
}
.cd-hero-status--invalid .cd-hero-status-dot { background: #FF8B8B; }
.cd-hero-status--reviewing .cd-hero-status-dot { background: #FFCC73; }
.cd-hero-status--expired .cd-hero-status-dot { background: #BFA1E0; }
.cd-hero-status-t {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.cd-hero-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* 奖章：双层圆环 + 金边 + 缎带 */
.cd-hero-medal-wrap {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  margin-bottom: 12rpx;
}
.cd-hero-medal-ring {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFD27A, #D4A748 50%, #B0842A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 12rpx 32rpx rgba(212, 167, 72, 0.55),
    inset 0 -10rpx 20rpx rgba(176, 132, 42, 0.45),
    inset 0 10rpx 20rpx rgba(255, 230, 175, 0.6);
}
.cd-hero-medal-inner {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 16rpx rgba(10, 123, 184, 0.18);
}
.cd-hero-medal-ribbon {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.22);
}

.cd-hero-name {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  max-width: 88%;
  text-shadow: 0 2rpx 16rpx rgba(7, 58, 92, 0.35);
}
.cd-hero-type {
  font-size: 22rpx;
  font-weight: 600;
  background: var(--cd-gold-light);
  color: #8A6118;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 10rpx rgba(212, 167, 72, 0.3);
}

.cd-hero-no {
  margin-top: 4rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(10rpx);
  transition: opacity 0.18s ease;
}
.cd-hero-no--hover { opacity: 0.7; }
.cd-hero-no-l {
  font-size: 18rpx;
  letter-spacing: 1.5rpx;
  color: rgba(255, 255, 255, 0.75);
}
.cd-hero-no-v {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  font-family: 'Courier New', monospace;
}

/* ───────── 关键信息：大字对开 ───────── */
.cd-validity {
  margin: -56rpx 32rpx 24rpx;
  background: var(--cd-surface);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(10, 123, 184, 0.12);
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  position: relative;
  z-index: 3;
}
.cd-validity-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.cd-validity-l {
  font-size: 24rpx;
  color: var(--cd-hint);
  letter-spacing: 0.5rpx;
}
.cd-validity-v {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--cd-text);
  letter-spacing: 1rpx;
  font-family: 'Helvetica Neue', Arial, sans-serif;
}
.cd-validity-divider {
  width: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.cd-validity-divider-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--cd-accent);
}
.cd-validity-divider-line {
  width: 2rpx;
  height: 56rpx;
  background: linear-gradient(180deg, transparent, #C9E2F0, transparent);
}
.cd-validity-tag {
  position: absolute;
  top: -22rpx;
  right: 32rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  letter-spacing: 0.5rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}
.cd-validity-tag--ok {
  background: linear-gradient(135deg, #2BC470, #1E7E34);
  color: #ffffff;
  animation: cd-tag-pulse 2s ease infinite;
}
.cd-validity-tag--permanent {
  background: linear-gradient(135deg, #D4A748, #B0842A);
  color: #ffffff;
}
@keyframes cd-tag-pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.04); }
}

/* ───────── 通用卡片 ───────── */
.cd-card {
  background: var(--cd-surface);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 22rpx rgba(10, 123, 184, 0.07);
  padding: 28rpx 32rpx 26rpx;
  margin: 0 24rpx 24rpx;
}
/* 卡片正文：用于「证书简介」（与「证书信息」卡保持视觉一致） */
.cd-card-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--cd-sub);
  white-space: pre-wrap;
  word-break: break-all;
  padding-top: 4rpx;
}
.cd-card-hd {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding-bottom: 14rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #EEF4F8;
}
.cd-card-dot {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #0A7BB8, #33ADDE);
  border-radius: 4rpx;
}
.cd-card-hd-t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--cd-text);
  letter-spacing: 0.5rpx;
}

.cd-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  line-height: 1.55;
  border-bottom: 1rpx solid #EEF4F8;
}
.cd-row:last-child { border-bottom: none; padding-bottom: 0; }

.cd-row-ico {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #E7F4FB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cd-row-l {
  flex-shrink: 0;
  width: 160rpx;
  color: var(--cd-hint);
  font-size: 26rpx;
}
.cd-row-v {
  flex: 1;
  word-break: break-all;
  color: var(--cd-text);
  text-align: right;
  font-size: 28rpx;
  font-weight: 500;
}
.cd-row-v--em {
  color: var(--cd-primary);
  font-weight: 700;
}


.cd-bottom-space { height: 32rpx; }

/* ───────── 底部固定操作栏 ───────── */
.cd-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #E0EAF0;
  display: flex;
  flex-direction: row;
  gap: 18rpx;
  z-index: 10;
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.cd-action {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  gap: 10rpx;
  transition: all 0.18s ease;
}
.cd-action--primary {
  background: linear-gradient(135deg, #0A7BB8 0%, #33ADDE 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(10, 123, 184, 0.42);
}
.cd-action--solo {
  /* 单按钮时撑满整条操作栏，去掉左右内边距的视觉留白 */
  margin: 0;
}
.cd-action--primary-hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 14rpx rgba(10, 123, 184, 0.34);
}

/* ───────── 状态屏（loading / error） ───────── */
.cd-state {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 24rpx;
}
.cd-state-spin {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #C9E2F0;
  border-top-color: var(--cd-primary);
  border-radius: 50%;
  animation: cd-spin 0.7s linear infinite;
}
.cd-state-ic { font-size: 96rpx; }
.cd-state-t {
  font-size: 28rpx;
  color: var(--cd-hint);
  text-align: center;
  max-width: 80%;
}
.cd-state-btn {
  margin-top: 24rpx;
  padding: 18rpx 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0A7BB8, #33ADDE);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(10, 123, 184, 0.32);
}
@keyframes cd-spin {
  to { transform: rotate(360deg); }
}
