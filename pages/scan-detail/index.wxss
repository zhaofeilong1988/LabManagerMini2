/* pages/scan-detail/index.wxss */
.sd2-page {
  --primary: #0A7BB8;
  --accent: #33ADDE;
  --bg: #F5FAFD;
  --text: #161C20;
  --sub: #41484D;
  --hint: #6E7F8A;
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

.sd2-content {
  padding: 24rpx 24rpx 60rpx;
}

/* ── 加载 / 错误居中态 ── */
.sd2-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 220rpx 60rpx 0;
}

.sd2-spin {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid #D4E6F0;
  border-top-color: var(--accent);
  animation: sd2-spin 0.8s linear infinite;
}

@keyframes sd2-spin {
  to { transform: rotate(360deg); }
}

.sd2-state-t {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--hint);
  text-align: center;
  line-height: 1.6;
}

.sd2-err-ic {
  font-size: 90rpx;
}

.sd2-state-btn {
  margin-top: 40rpx;
  min-width: 320rpx;
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0A7BB8, #33ADDE);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.sd2-state-btn--ghost {
  margin-top: 24rpx;
  background: #FFFFFF;
  color: var(--primary);
  border: 2rpx solid #CFE3EE;
  box-shadow: none;
}

/* ── 设备编号头部 ── */
.sd2-hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.sd2-hero-ic {
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #DBEFF9, #C9E9FA);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.sd2-hero-b {
  flex: 1;
  min-width: 0;
}

.sd2-hero-t {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.sd2-no {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-family: Menlo, Consolas, monospace;
  color: var(--primary);
  word-break: break-all;
}

/* ── 卡片与字段行 ── */
.sd2-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-top: 20rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.sd2-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #E1EBF2;
}

.sd2-row:last-child {
  border-bottom: none;
}

.sd2-k {
  color: var(--hint);
  flex-shrink: 0;
  line-height: 1.5;
  font-size: 24rpx;
}

.sd2-v {
  flex: 1;
  min-width: 0;
  color: var(--text);
  font-weight: 600;
  text-align: right;
  line-height: 1.5;
  word-break: break-all;
}

/* 值样式：主强调 / 等宽编号 / 开机状态着色 */
.sd2-v--strong {
  font-size: 30rpx;
  font-weight: 700;
  color: #161C20;
}

.sd2-v--mono {
  font-family: Menlo, Consolas, monospace;
  word-break: break-all;
}

.sd2-v--ok {
  color: #0D86BE;
}

.sd2-v--off {
  color: #E65100;
}

/* ── 开机 / 关机 操作按钮 ── */
.sd2-power {
  margin-top: 20rpx;
  padding: 26rpx 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
}

.sd2-power--on {
  background: linear-gradient(135deg, #0A7BB8, #33ADDE);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(10, 123, 184, 0.25);
}

.sd2-power--off {
  background: #FFFFFF;
  color: #E65100;
  border: 2rpx solid #F4C9A8;
}

.sd2-power--hover {
  opacity: 0.82;
}

/* 手机号：可点击呼出 */
.sd2-phone {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  color: #0A7BB8;
}

.sd2-phone--hover {
  opacity: 0.55;
}

.sd2-hover {
  opacity: 0.75;
}

/* 蓝牙操作进度提示（搜索设备 / 握手 / 下发指令） */
.sd2-ble-msg {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--hint);
  line-height: 1.5;
}
